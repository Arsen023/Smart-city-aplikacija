{
  "name": "smart-city-aplikacija",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build:a": "cross-env UI=ui-a vite build",
    "build:b": "cross-env UI=ui-b vite build",
    "build:chat": "cross-env UI=chat vite build && cross-env UI=chat-sandbox vite build",
    "build": "npm run typecheck && npm run build:a && npm run build:b && npm run build:chat",
    "start": "tsx main.ts",
    "baza:provera": "tsx src/core/baza/provera.ts",
    "baza:uvoz": "tsx src/core/baza/uvoz/uvoz.ts",
    "chat": "tsx src/chat/server.ts",
    "demo": "npm run build && concurrently -n server,chat -c blue,magenta \"tsx main.ts\" \"tsx src/chat/server.ts\"",
    "dev": "concurrently \"cross-env UI=ui-a NODE_ENV=development vite build --watch\" \"cross-env UI=ui-b NODE_ENV=development vite build --watch\" \"tsx watch main.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arsen023/Smart-city-aplikacija.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Arsen023/Smart-city-aplikacija/issues"
  },
  "homepage": "https://github.com/Arsen023/Smart-city-aplikacija#readme",
  "dependencies": {
    "@a2ui/agent": "^0.1.0",
    "@a2ui/lit": "^0.15.0",
    "@a2ui/web_core": "^0.15.0",
    "@ai-sdk/openai-compatible": "^1.0.63",
    "@copilotkit/a2ui-renderer": "^1.90.2",
    "@copilotkit/react-core": "^1.90.2",
    "@copilotkit/runtime": "^1.90.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lit": "^3.3.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
