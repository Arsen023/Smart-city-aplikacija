# Kopiraj u .env i upiši vrednosti. .env se nikad ne commituje.

# K3 LLM savet (Groq)
GROQ_API_KEY=
# Opciono, podrazumevano openai/gpt-oss-120b (isproban i qwen/qwen3.8-27b)
GROQ_MODEL=

# K1 ekoNET klijent (src/core/ekonet). Prazno znači podrazumevanu vrednost.
# Izvor podataka: demo | api
# demo = scenariji iz fixtures/ (podrazumevano)
# api  = pravi ekoNET API; još ne radi, čeka T01
EKONET_IZVOR=

# Demo scenario kad je EKONET_IZVOR=demo (podrazumevano s1-dobar):
# s1-dobar | s2-los | s3-zastareo | s4-bez-pm25 | s5-llm-greska | s6-bez-podataka
EKONET_SCENARIO=

# Baza za merenja kvaliteta vode (PostgreSQL, tabele iz db/01-sema.sql).
# Bez ovoga alati za vodu javljaju da baza nije podešena; ostatak aplikacije radi.
# DATABASE_URL=postgres://postgres:LOZINKA@localhost:5432/smartcity
DATABASE_URL=
