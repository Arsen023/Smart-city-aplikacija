# Kopiraj u .env i upiši vrednosti. .env se nikad ne commituje.

# K3 LLM savet (Groq)
GROQ_API_KEY=
# Opciono, podrazumevano openai/gpt-oss-120b (isproban i qwen/qwen3.8-27b)
GROQ_MODEL=

# Chat aplikacija (opciono). Chat model, podrazumevano isti kao GROQ_MODEL.
GROQ_CHAT_MODEL=
# Model koji u verziji B sastavlja A2UI ekran; podrazumevano openai/gpt-oss-120b.
# Poseban model ima poseban Groq limit (besplatni nivo: 8000 tokena/min po modelu).
GROQ_A2UI_MODEL=
# Model za verziju B preko CopilotKit-a (podrazumevano openai/gpt-oss-120b).
GROQ_COPILOT_MODEL=

# K1 ekoNET klijent (src/core/ekonet). Prazno znači podrazumevanu vrednost.
# Izvor podataka: demo | baza | api
# demo = scenariji iz fixtures/ (podrazumevano)
# baza = naša PostgreSQL baza (DATABASE_URL); vazduh iz Open-Meteo i Sensor.Community,
#        server ga sam uvozi na svakih BAZA_UVOZ_MIN minuta (db/03-vazduh-vreme.sql mora biti pokrenut)
# api  = pravi ekoNET API; još ne radi, čeka T01
EKONET_IZVOR=

# Koliko često server uvozi vreme i vazduh kad je EKONET_IZVOR=baza (minuti, podrazumevano 30, 0 = isključeno)
BAZA_UVOZ_MIN=

# Demo scenario kad je EKONET_IZVOR=demo (podrazumevano s1-dobar):
# s1-dobar | s2-los | s3-zastareo | s4-bez-pm25 | s5-llm-greska | s6-bez-podataka
EKONET_SCENARIO=

# Baza za merenja kvaliteta vode (PostgreSQL, tabele iz db/01-sema.sql).
# Bez ovoga alati za vodu javljaju da baza nije podešena; ostatak aplikacije radi.
# DATABASE_URL=postgres://postgres:LOZINKA@localhost:5432/smartcity
DATABASE_URL=
